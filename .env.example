# Copy this file to .env and fill in real values. .env is ignored by Git; this file is not.
# NEVER commit real secrets (tokens, passwords, keys) to the repository.

APP_NAME=BA WorkTrack
# development | production (production refuses the default SECRET_KEY and sets Secure cookies)
ENVIRONMENT=development

# Signs login tokens. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
# Encrypts JIRA / ADO tokens stored in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if you lose or change it, stored integration tokens must be re-entered.
ENCRYPTION_KEY=

# SQLite for a laptop; PostgreSQL in production, e.g.
#   DATABASE_URL=postgresql+psycopg://worktrack:password@localhost:5432/worktrack
DATABASE_URL=sqlite:///./worktrack.db

# First admin, created at start-up only when there are no users yet
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Sessions and login protection
ACCESS_TOKEN_MINUTES=480
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Uploads
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10

# AI Studio: ollama (local, free) or disabled
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# Background jobs (weekly report every Friday 17:00, integration sync every 30 min).
# With several web workers, enable on one only.
SCHEDULER_ENABLED=true
WEEKLY_REPORT_DAY=fri
WEEKLY_REPORT_HOUR=17
SYNC_INTERVAL_MINUTES=30
